# Postgres
DATABASE_URL=postgres://xreader:xreader@postgres:5432/xreader?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# GitHub OAuth
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
GITHUB_OAUTH_CALLBACK=http://localhost:3000/api/auth/callback/github

# Sessions
SESSION_SECRET=<64-random-bytes-base64>

# AI (OpenAI-compatible)
XREADER_AI_CONFIG=/etc/xreader/ai.yaml
OPENAI_API_KEY=sk-...
OPENAI_ENDPOINT=https://api.openai.com

# Misc
LOG_LEVEL=info
TZ=Asia/Shanghai
